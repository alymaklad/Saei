[Unit]
Description=Job Application Agent - APScheduler (daily/weekly triggers)
After=network.target

[Service]
Type=simple
User=job-agent
WorkingDirectory=/opt/job-agent
EnvironmentFile=/opt/job-agent/.env
ExecStart=/opt/job-agent/.venv/bin/python scheduler.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
