# ── LLM provider (free options only) ──────────────────────────────
# "ollama"  = local model, fully free, no API key, needs Ollama running locally
# "gemini"  = Google Gemini API free tier, needs GEMINI_API_KEY
# "groq"    = Groq API free tier (fast hosted inference), needs GROQ_API_KEY
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Job search ─────────────────────────────────────────────────────
# Greenhouse/Lever public APIs need no key. SerpAPI free tier = 100 searches/month.
# GREENHOUSE_BOARD_TOKENS/LEVER_COMPANY_SLUGS below are optional -- the same
# boards can also be added from the dashboard's Search tab (paste the board's
# URL), which stores them in the DB instead of here. Both sources are merged.
SERPAPI_KEY=
GREENHOUSE_BOARD_TOKENS=stripe,airbnb
LEVER_COMPANY_SLUGS=netflix
# Default job title/position to search for. Used by the Search tab's
# "Search now" button and by the scheduler's automatic 8am run.
SEARCH_POSITION_QUERY=
# Seniority filter -- one of: intern, entry, mid, senior, lead, manager.
# Leave blank for no filter (any level).
SEARCH_SENIORITY_LEVEL=

# ── Google Sheets watchlist (free, Google Cloud service account) ───
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json

# ── Gmail API (free, sends application emails from your own Gmail) ─
GMAIL_CREDENTIALS_JSON=credentials/gmail_credentials.json
GMAIL_TOKEN_JSON=credentials/gmail_token.json
APPLICANT_NAME=Aly Tarek
APPLICANT_EMAIL=alytarek.maklad@gmail.com

# ── Telegram bot (free, replaces paid Twilio WhatsApp for reports) ─
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Whitelist: sources allowed to auto-submit, comma separated ─────
# Leave EMPTY until you've manually verified a board's submit flow.
# Example once verified: WHITELISTED_SOURCES=greenhouse:stripe,lever:netflix
WHITELISTED_SOURCES=

# ── Safety ───────────────────────────────────────────────────────
# When true, every "send email" / "submit application" action is logged, not executed.
DRY_RUN=false

# ── Storage ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/job_agent.db
